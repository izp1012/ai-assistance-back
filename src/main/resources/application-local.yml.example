server:
  port: 8081
  servlet:
    encoding:
      charset: UTF-8
      force: true

spring:
  datasource:
    # Docker 로컬 PostgreSQL 사용 시 (docker-compose up -d 실행 필요)
    url: jdbc:postgresql://localhost:5432/your-db-name
    driver-class-name: org.postgresql.Driver
    username: your-db-username
    password: your-db-password
    # H2 인메모리 DB 사용 시 아래 주석 해제 후 위 설정 주석 처리
    #url: jdbc:h2:mem:test;MODE=MySQL
    #driver-class-name: org.h2.Driver
    #username: sa
    #password:
    #h2:
    #  console:
    #    enabled: true

  jpa:
    open-in-view: false
    hibernate:
      ddl-auto: update
    properties:
      '[hibernate.default_batch_fetch_size]': 100
      '[hibernate.format_sql]': true
    show-sql: true

  security:
    oauth2:
      client:
        registration:
          google:
            client-id: your-google-client-id
            client-secret: your-google-client-secret
            scope:
              - email
              - profile

  # Quartz 배치 스케줄러 설정 (dev 환경과 동일하게 JDBC 방식 사용 시 활성화)
  #quartz:
  #  job-store-type: jdbc
  #  jdbc:
  #    initialize-schema: always
  #  properties:
  #    org:
  #      quartz:
  #        scheduler:
  #          instanceName: QuartzScheduler
  #        jobStore:
  #          class: org.quartz.impl.jdbcjobstore.JobStoreTX
  #          driverDelegateClass: org.quartz.impl.jdbcjobstore.PostgreSQLDelegate
  #          tablePrefix: QRTZ_
  #          useProperties: true
  #          dataSource: uf
  #        dataSource:
  #          uf:
  #            driver: org.postgresql.Driver
  #            URL: jdbc:postgresql://localhost:5432/your-db-name
  #            user: your-db-username
  #            password: your-db-password
  #            maxConnections: 10
  #        threadPool:
  #          threadCount: 5

  ai:
    openai:
      api-key: your-openai-api-key
      base-url: https://api.openai.com
      chat:
        options:
          model: gpt-4o

  output:
    ansi:
      enabled: always

logging:
  level:
    com.uf.assistance: DEBUG
    org.hibernate.orm.jdbc.bind: TRACE

flask:
  api:
    base-url: http://localhost:5001

openai:
  api:
    url: https://api.openai.com/v1/chat/completions

IMAGE_BASE_URL: http://localhost:8081/api/image

file:
  upload-dir: ./uploads

# HS512 알고리즘 사용으로 최소 64자(512bit) 이상 필요
jwt:
  secret: your-64-characters-minimum-jwt-secret-key-required-for-hs512

app:
  server:
    dev-url: http://localhost:8081
    local-url: http://localhost:8081
  oauth2:
    redirect-uri: http://localhost:3000/
